@startuml
title Diagrama de Despliegue - Sistema de Artículos Académicos

' ===== CLIENTE =====
node "Cliente Web/Móvil" {
  artifact "Navegador / App" as cliente
}

' ===== API GATEWAY =====
node "API Gateway" {
  component "Gateway" as gateway
}

' ===== MICROSERVICIO USUARIOS =====
node "MS Usuarios" {
  component "UsuarioControl"
  component "UsuarioServicio"
  component "UsuarioRepositorio"
  database "DB_Usuarios" as dbUsuarios
}

' ===== MICROSERVICIO ARTICULOS =====
node "MS Artículos" {
  component "ArticuloControl"
  component "ArticuloServicio"
  component "ArticuloRepositorio"
  database "DB_Articulos" as dbArticulos
}

' ===== MICROSERVICIO EDITORIAL =====
node "MS Editorial" {
  component "RevisionControl"
  component "RevisionServicio"
  component "RevisionRepositorio"
  database "DB_Editorial" as dbEditorial
}

' ===== MICROSERVICIO PUBLICACION =====
node "MS Publicación" {
  component "PublicacionControl"
  component "PublicacionServicio"
  component "PublicacionRepositorio"
  database "DB_Publicacion" as dbPublicacion
}

' ===== MICROSERVICIO ADMIN =====
node "MS Administración" {
  component "AdminControl"
  component "AdminServicio"
  component "AdminRepositorio"
  database "DB_Admin" as dbAdmin
}

' ===== CONEXIONES CLIENTE =====
cliente --> gateway : HTTPS/REST

' ===== GATEWAY A MICROSERVICIOS =====
gateway --> UsuarioControl
gateway --> ArticuloControl
gateway --> RevisionControl
gateway --> PublicacionControl
gateway --> AdminControl

' ===== CONEXIONES INTERNAS =====
UsuarioControl --> UsuarioServicio
UsuarioServicio --> UsuarioRepositorio
UsuarioRepositorio --> dbUsuarios

ArticuloControl --> ArticuloServicio
ArticuloServicio --> ArticuloRepositorio
ArticuloRepositorio --> dbArticulos

RevisionControl --> RevisionServicio
RevisionServicio --> RevisionRepositorio
RevisionRepositorio --> dbEditorial

PublicacionControl --> PublicacionServicio
PublicacionServicio --> PublicacionRepositorio
PublicacionRepositorio --> dbPublicacion

AdminControl --> AdminServicio
AdminServicio --> AdminRepositorio
AdminRepositorio --> dbAdmin

' ===== COMUNICACION ENTRE MICROSERVICIOS =====
ArticuloServicio --> UsuarioServicio : validar usuario
RevisionServicio --> ArticuloServicio : consultar articulo
PublicacionServicio --> RevisionServicio : verificar aprobación
AdminServicio --> UsuarioServicio : gestionar usuarios

@enduml
